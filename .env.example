# Application
PORT=3000
CORS_ORIGINS=https://front-pyments.onrender.com

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core_payments?schema=public

# Wompi (UAT sandbox)
WOMPI_PUBLIC_KEY=pub_stagtest_xxx
WOMPI_PRIVATE_KEY=prv_stagtest_xxx
WOMPI_INTEGRITY_SECRET=stagtest_integrity_xxx
WOMPI_EVENTS_SECRET=stagtest_events_xxx
WOMPI_API_URL=https://api-sandbox.co.uat.wompi.dev/v1
WOMPI_CHECKOUT_URL=https://checkout.co.uat.wompi.dev/p/
WOMPI_REDIRECT_URL=http://localhost:3000/payment/result

# Transaction sync (active polling when PENDING)
WOMPI_MAX_RETRIES=3
WOMPI_RETRY_DELAY_MS=500

# Fees (in centavos)
BASE_FEE_IN_CENTS=250000
SHIPPING_FEE_IN_CENTS=300000

# Currency
CURRENCY=COP
